# --- DeepSeek (job extraction, OpenAI-compatible API) ---
# Key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Email (Gmail: enable 2FA, then create an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# --- Weekly schedule (default: Monday 09:00, machine local time) ---
SCHEDULE_DAY=mon
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0
# SCHEDULE_TZ=Asia/Ho_Chi_Minh
